---
import BaseLayout from './BaseLayout.astro';
import ComplexityCard from '../components/lab/ComplexityCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'algorithms'>;
}

const { entry } = Astro.props;
const data = entry.data;
---

<BaseLayout title={data.title} description={data.summary} activeModule={data.module}>
  <div class="lab-page">
    <article class="lab-prose">
      <header class="page-head">
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>
        <div class="tag-row">
          {data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="meta-row">
          <ComplexityCard label="时间复杂度" value={data.timeComplexity} />
          <ComplexityCard label="空间复杂度" value={data.spaceComplexity} />
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
    <aside class="lab-panel">
      <slot name="lab" />
    </aside>
  </div>
</BaseLayout>
